/**
 * ReportCoverageTab Component
 * 
 * Displays TSC and COSO framework coverage with donut charts and detailed criteria tables.
 */

import React from 'react';
import { Box, Typography, Tooltip, Popover, IconButton } from '@mui/material';
import { 
  CheckCircle as CheckCircleIcon, 
  Cancel as CancelIcon, 
  Warning as WarningIcon,
  Assignment as AssignmentIcon,
  InfoOutlined as InfoOutlinedIcon
} from '@mui/icons-material';
import { PieChart, Pie, Cell, Tooltip as RechartsTooltip } from 'recharts';
import { TSC_CRITERIA, CONTROL_TSC_SECTIONS } from '../../../config/report/tscCriteria';
import { parseMapping } from '../../../services/report/dataTransformations';
import { deduplicateCuecs } from '../../../services/report/reportUtils';

interface FrameworkCriteria {
  tsc: { [section: string]: Array<{ id: string; description: string }> };
  coso: { [section: string]: Array<{ id: string; description: string }> };
}

interface ReportCoverageTabProps {
  frameworkCriteria: FrameworkCriteria | null;
  tscCoveredByControls: number;
  tscCoveredByCuecs: number;
  tscLikelyCovered: number;
  tscTotal: number;
  tscMissed: number;
  cosoCoveredByControls: number;
  cosoCoveredByCuecs: number;
  cosoLikelyCovered: number;
  cosoTotal: number;
  cosoMissed: number;
  tscIdsFound: Set<string>;
  cosoIdsFound: Set<string>;
  tscIdsByCuecs: Set<string>;
  cosoIdsByCuecs: Set<string>;
  missingTscIds: string[];
  missingCosoIds: string[];
  highConfControlsForCoverage: any[];
  highConfCuecsFiltered: any[];
  getCoverageStatus: (
    frameworkId: any, 
    controls: any[], 
    idKey: string, 
    missingIds: string[], 
    cuecIds: Set<string>
  ) => {
    covered: boolean;
    exception: boolean;
    cuecCovered: boolean;
    likelyCovered: boolean;
    coverageType: string;
  };
  onOpenCuecModal: (cuec: any) => void;
  onOpenControlModal?: (control: any) => void;
}

export const ReportCoverageTab = React.memo(function ReportCoverageTab({
  frameworkCriteria,
  tscCoveredByControls,
  tscCoveredByCuecs,
  tscLikelyCovered,
  tscTotal,
  tscMissed,
  cosoCoveredByControls,
  cosoCoveredByCuecs,
  cosoLikelyCovered,
  cosoTotal,
  cosoMissed,
  tscIdsFound,
  cosoIdsFound,
  tscIdsByCuecs,
  cosoIdsByCuecs,
  missingTscIds,
  missingCosoIds,
  highConfControlsForCoverage,
  highConfCuecsFiltered,
  getCoverageStatus,
  onOpenCuecModal,
  onOpenControlModal
}: ReportCoverageTabProps) {
  const [controlPopoverAnchor, setControlPopoverAnchor] = React.useState<{el: HTMLElement, controls: any[]} | null>(null);
  const [cuecPopoverAnchor, setCuecPopoverAnchor] = React.useState<{el: HTMLElement, cuecs: any[]} | null>(null);
  
  // Donut chart data generator
  const donutDataFourCategories = (
    controlsCovered: number, 
    cuecsCovered: number, 
    likelyCovered: number, 
    missed: number
  ) => [
    { name: 'Covered', value: controlsCovered },
    { name: 'CUEC', value: cuecsCovered },
    { name: 'Likely Covered', value: likelyCovered },
    { name: 'Missed', value: missed },
  ];

  const donutColorsFourCategories = ['#4caf50', '#9c27b0', '#ff9800', '#e57373']; // green, purple, orange, red

  return (
    <>
      <Typography variant="h5" gutterBottom sx={{ fontSize: 18, mb: 2 }}>
        TSC & COSO Coverage
      </Typography>

      {/* TSC/COSO Row (split in half) */}
      <Box className="tsc-coso-row">
        {/* TSC Half */}
        <Box className="tsc-coso-half">
          <div className="tsc-coso-donut-title">TSC Coverage</div>
          <div className="tsc-coso-donut-wrapper">
            <PieChart width={140} height={140}>
              <Pie 
                data={donutDataFourCategories(tscCoveredByControls, tscCoveredByCuecs, tscLikelyCovered, tscMissed)} 
                dataKey="value" 
                nameKey="name" 
                cx="50%" 
                cy="50%" 
                innerRadius={38} 
                outerRadius={60} 
                label={false}
              >
                {donutDataFourCategories(tscCoveredByControls, tscCoveredByCuecs, tscLikelyCovered, tscMissed).map((entry: any, idx: number) => (
                  <Cell key={idx} fill={donutColorsFourCategories[idx]} />
                ))}
              </Pie>
              <RechartsTooltip formatter={(value: any, name: any) => [`${value} items`, name]} />
            </PieChart>
            <div className="tsc-coso-donut-legend">
              <span className="legend-covered" /> Covered
              <span className="legend-cuec" style={{ backgroundColor: '#9c27b0' }} /> CUEC
              <span className="legend-likely-covered" style={{ backgroundColor: '#ff9800' }} /> Likely Covered
              <span className="legend-missing" /> Missed
            </div>
          </div>
          <div className="tsc-coso-donut-value">
            {tscCoveredByControls + tscCoveredByCuecs}/{tscTotal} ({(((tscCoveredByControls + tscCoveredByCuecs)/tscTotal)*100).toFixed(0)}%)
          </div>

          {/* TSC Checklist Table */}
          <div className="tsc-coso-align-heading">TSC Alignment</div>
          {Object.entries(CONTROL_TSC_SECTIONS).map(([section, tscIds]) => (
            <div key={section} className="tsc-coso-section-block">
              <div className="tsc-coso-section-title">{section}</div>
              <table className="tsc-coso-table">
                <thead>
                  <tr>
                    <th>TSC ID</th>
                    <th>Description</th>
                    <th>Covered</th>
                  </tr>
                </thead>
                <tbody>
                  {tscIds.map((tscId) => {
                    const crit = TSC_CRITERIA.find(c => c.id === tscId);
                    const { exception, coverageType } = getCoverageStatus(
                      tscId, 
                      highConfControlsForCoverage, 
                      'control_tsc_id', 
                      missingTscIds, 
                      tscIdsByCuecs
                    );
                    
                    // Collect controls that map to this criterion
                    const mappedControls = highConfControlsForCoverage.filter((c: any) => {
                      if (String(c?.control_tsc_id ?? '').replace(/\s+/g, '').toUpperCase() === String(tscId).replace(/\s+/g, '').toUpperCase()) {
                        return true;
                      }
                      const tscMappings = parseMapping(c.control_tsc_mappings || []);
                      if (tscMappings.length > 0) {
                        return tscMappings.some((m: any) => m.id === tscId);
                      }
                      return false;
                    });
                    
                    // Collect CUECs that map to this criterion
                    const mappedCuecs = highConfCuecsFiltered.filter((cuec: any) => {
                      if (cuec.cuec_tsc_id === tscId) return true;
                      const tscMappings = parseMapping(cuec.cuec_tsc_mappings || []);
                      if (tscMappings.length > 0) {
                        return tscMappings.some((m: any) => m.id === tscId);
                      }
                      return false;
                    });
                    
                    const devList = (highConfControlsForCoverage || [])
                      .filter((c: any) => 
                        String(c?.control_tsc_id ?? '').replace(/\s+/g, '').toUpperCase() === String(tscId).replace(/\s+/g, '').toUpperCase() && 
                        c.has_deviation === true && 
                        typeof c.deviation_desc === 'string' && 
                        c.deviation_desc.trim()
                      )
                      .map((c: any) => c.deviation_desc);
                    const hasDev = devList.length > 0;

                    return (
                      <tr key={tscId} className={(exception || hasDev) ? 'tsc-coso-row-exception' : ''}>
                        <td>{tscId}</td>
                        <td>
                          {hasDev ? (
                            <Tooltip title={<span style={{ whiteSpace: 'pre-line' }}>{(devList || []).join('\n')}</span>}>
                              <span>{crit ? crit.description : ''}</span>
                            </Tooltip>
                          ) : (
                            crit ? crit.description : ''
                          )}
                        </td>
                        <td style={{ textAlign: 'center' }}>
                          <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 0.5 }}>
                            {coverageType === 'control' ? (
                              <CheckCircleIcon sx={{ color: '#4caf50', fontSize: 18 }} />
                            ) : coverageType === 'cuec' ? (
                              <Tooltip title="Covered by CUEC">
                                <AssignmentIcon sx={{ color: '#9c27b0', fontSize: 18 }} />
                              </Tooltip>
                            ) : coverageType === 'likely' ? (
                              <Tooltip title="Likely covered under another control - found in extracted text">
                                <WarningIcon sx={{ color: '#ff9800', fontSize: 18 }} />
                              </Tooltip>
                            ) : (
                              <CancelIcon sx={{ color: '#e57373', fontSize: 18 }} />
                            )}
                            {mappedControls.length > 0 && (
                              <InfoOutlinedIcon 
                                sx={{ color: '#1976d2', fontSize: 16, cursor: 'pointer', ml: 0.5 }} 
                                onClick={(e) => {
                                  e.stopPropagation();
                                  setControlPopoverAnchor({el: e.currentTarget.parentElement as HTMLElement, controls: mappedControls});
                                }}
                              />
                            )}
                            {mappedCuecs.length > 0 && (
                              <AssignmentIcon 
                                sx={{ color: '#9c27b0', fontSize: 16, cursor: 'pointer' }} 
                                onClick={(e) => {
                                  e.stopPropagation();
                                  setCuecPopoverAnchor({el: e.currentTarget.parentElement as HTMLElement, cuecs: deduplicateCuecs(mappedCuecs)});
                                }}
                              />
                            )}
                          </Box>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ))}
        </Box>

        {/* COSO Half */}
        <Box className="tsc-coso-half">
          <div className="tsc-coso-donut-title">COSO Coverage</div>
          <div className="tsc-coso-donut-wrapper">
            <PieChart width={140} height={140}>
              <Pie 
                data={donutDataFourCategories(cosoCoveredByControls, cosoCoveredByCuecs, cosoLikelyCovered, cosoMissed)} 
                dataKey="value" 
                nameKey="name" 
                cx="50%" 
                cy="50%" 
                innerRadius={38} 
                outerRadius={60} 
                label={false}
              >
                {donutDataFourCategories(cosoCoveredByControls, cosoCoveredByCuecs, cosoLikelyCovered, cosoMissed).map((entry: any, idx: number) => (
                  <Cell key={idx} fill={donutColorsFourCategories[idx]} />
                ))}
              </Pie>
              <RechartsTooltip formatter={(value: any, name: any) => [`${value} items`, name]} />
            </PieChart>
            <div className="tsc-coso-donut-legend">
              <span className="legend-covered" /> Covered
              <span className="legend-cuec" style={{ backgroundColor: '#9c27b0' }} /> CUEC
              <span className="legend-likely-covered" style={{ backgroundColor: '#ff9800' }} /> Likely Covered
              <span className="legend-missing" /> Missed
            </div>
          </div>
          <div className="tsc-coso-donut-value">
            {cosoCoveredByControls + cosoCoveredByCuecs}/{cosoTotal} ({(((cosoCoveredByControls + cosoCoveredByCuecs)/cosoTotal)*100).toFixed(0)}%)
          </div>

          {/* COSO Checklist Table */}
          <div className="tsc-coso-align-heading">COSO Alignment</div>
          {frameworkCriteria && frameworkCriteria.coso && (
            Object.entries(frameworkCriteria.coso).map(([section, criteria]) => (
              <div key={section} className="tsc-coso-section-block">
                <div className="tsc-coso-section-title">{section}</div>
                <table className="tsc-coso-table">
                  <thead>
                    <tr>
                      <th>COSO ID</th>
                      <th>Description</th>
                      <th>Covered</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(criteria as any[]).map((crit: any) => {
                      const { exception, coverageType } = getCoverageStatus(
                        crit.id, 
                        highConfControlsForCoverage, 
                        'control_coso_id', 
                        missingCosoIds, 
                        cosoIdsByCuecs
                      );
                      
                      // Collect controls that map to this criterion
                      const mappedControls = highConfControlsForCoverage.filter((c: any) => {
                        if (String(c?.control_coso_id ?? '') === String(crit.id)) {
                          return true;
                        }
                        const cosoMappings = parseMapping(c.control_coso_mappings || []);
                        if (cosoMappings.length > 0) {
                          return cosoMappings.some((m: any) => m.id === String(crit.id));
                        }
                        return false;
                      });
                      
                      // Collect CUECs that map to this criterion
                      const mappedCuecs = highConfCuecsFiltered.filter((cuec: any) => {
                        if (cuec.cuec_coso_id === crit.id) return true;
                        const cosoMappings = parseMapping(cuec.cuec_coso_mappings || []);
                        if (cosoMappings.length > 0) {
                          return cosoMappings.some((m: any) => m.id === String(crit.id));
                        }
                        return false;
                      });
                      
                      const devList = (highConfControlsForCoverage || [])
                        .filter((c: any) => 
                          String(c.control_coso_id) === String(crit.id) && 
                          c.has_deviation === true && 
                          typeof c.deviation_desc === 'string' && 
                          c.deviation_desc.trim()
                        )
                        .map((c: any) => c.deviation_desc);
                      const hasDev = devList.length > 0;

                      return (
                        <tr key={crit.id} className={(exception || hasDev) ? 'tsc-coso-row-exception' : ''}>
                          <td>{crit.id}</td>
                          <td>
                            {hasDev ? (
                              <Tooltip title={<span style={{ whiteSpace: 'pre-line' }}>{(devList || []).join('\n')}</span>}>
                                <span>{crit.description}</span>
                              </Tooltip>
                            ) : (
                              crit.description
                            )}
                          </td>
                          <td style={{ textAlign: 'center' }}>
                            <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 0.5 }}>
                              {coverageType === 'control' ? (
                                <CheckCircleIcon sx={{ color: '#4caf50', fontSize: 18 }} />
                              ) : coverageType === 'cuec' ? (
                                <Tooltip title="Covered by CUEC">
                                  <AssignmentIcon sx={{ color: '#9c27b0', fontSize: 18 }} />
                                </Tooltip>
                              ) : coverageType === 'likely' ? (
                                <Tooltip title="Likely covered under another control - found in extracted text">
                                  <WarningIcon sx={{ color: '#ff9800', fontSize: 18 }} />
                                </Tooltip>
                              ) : (
                                <CancelIcon sx={{ color: '#e57373', fontSize: 18 }} />
                              )}
                              {mappedControls.length > 0 && (
                                <InfoOutlinedIcon 
                                  sx={{ color: '#1976d2', fontSize: 16, cursor: 'pointer', ml: 0.5 }} 
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    setControlPopoverAnchor({el: e.currentTarget.parentElement as HTMLElement, controls: mappedControls});
                                  }}
                                />
                              )}
                              {mappedCuecs.length > 0 && (
                                <AssignmentIcon 
                                  sx={{ color: '#9c27b0', fontSize: 16, cursor: 'pointer' }} 
                                  onClick={(e) => {
                                    e.stopPropagation();
                                    setCuecPopoverAnchor({el: e.currentTarget.parentElement as HTMLElement, cuecs: deduplicateCuecs(mappedCuecs)});
                                  }}
                                />
                              )}
                            </Box>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ))
          )}
        </Box>
      </Box>

      {/* Control Popover */}
      <Popover
        open={Boolean(controlPopoverAnchor)}
        anchorEl={controlPopoverAnchor?.el}
        onClose={() => setControlPopoverAnchor(null)}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'left' }}
        transformOrigin={{ vertical: 'top', horizontal: 'left' }}
      >
        <Box sx={{ p: 0.5 }}>
          <Box sx={{ fontSize: '12px', fontWeight: 'bold', mb: 0.5 }}>
            Controls ({controlPopoverAnchor?.controls.length || 0}):
          </Box>
          <Box component="ul" sx={{ m: '4px 0', pl: '20px', fontSize: '11px' }}>
            {controlPopoverAnchor?.controls.map((c: any) => (
              <Box
                component="li"
                key={c.id}
                sx={{ 
                  cursor: onOpenControlModal ? 'pointer' : 'default', 
                  textDecoration: onOpenControlModal ? 'underline' : 'none',
                  '&:hover': onOpenControlModal ? { bgcolor: 'action.hover' } : {},
                }}
                onClick={onOpenControlModal ? () => {
                  onOpenControlModal(c);
                  setControlPopoverAnchor(null);
                } : undefined}
              >
                {c.control_id || `Control ${c.id}`}
              </Box>
            ))}
          </Box>
        </Box>
      </Popover>

      {/* CUEC Popover */}
      <Popover
        open={Boolean(cuecPopoverAnchor)}
        anchorEl={cuecPopoverAnchor?.el}
        onClose={() => setCuecPopoverAnchor(null)}
        anchorOrigin={{ vertical: 'bottom', horizontal: 'left' }}
        transformOrigin={{ vertical: 'top', horizontal: 'left' }}
      >
        <Box sx={{ p: 0.5 }}>
          <Box sx={{ fontSize: '12px', fontWeight: 'bold', mb: 0.5 }}>
            CUECs ({cuecPopoverAnchor?.cuecs.length || 0}):
          </Box>
          <Box component="ul" sx={{ m: '4px 0', pl: '20px', fontSize: '11px' }}>
            {cuecPopoverAnchor?.cuecs.map((cuec: any) => (
              <Box
                key={cuec.id}
                component="li"
                sx={{
                  cursor: 'pointer',
                  textDecoration: 'underline',
                  '&:hover': { bgcolor: 'action.hover' },
                }}
                onClick={() => {
                  onOpenCuecModal(cuec);
                  setCuecPopoverAnchor(null);
                }}
              >
                {(cuec.cuec_description || cuec.cuec_id || `CUEC ${cuec.id}`).substring(0, 60)}
                {((cuec.cuec_description || '').length > 60) ? '...' : ''}
              </Box>
            ))}
          </Box>
        </Box>
      </Popover>
    </>
  );
});
