          </Card>

          <Card sx={{ mb: 3 }}>
            <CardContent>
              <Typography variant="h6" gutterBottom color="primary">
                Understanding Confidence Thresholds
              </Typography>
              <Paper sx={{ p: 2, bgcolor: 'grey.50', mb: 2 }}>
                <Typography variant="body2" fontWeight="bold">
                  Confidence Ranges:
                </Typography>
                <Typography variant="body2" component="div" sx={{ mt: 1 }}>
                  • <strong>0.90-1.00:</strong> Excellent - High confidence in extraction accuracy<br />
                  • <strong>0.75-0.89:</strong> Good - Default threshold, generally reliable<br />
                  • <strong>0.60-0.74:</strong> Fair - Review recommended<br />
                  • <strong>0.30-0.59:</strong> Poor - Manual verification required<br />
                  • <strong>0.10-0.29:</strong> Extraction error - Likely needs correction<br />
                  • <strong>0.00-0.09:</strong> Merged secondary - Intentionally set to 0
                </Typography>
              </Paper>

              <Alert severity="info">
                The default confidence threshold of 0.75 balances precision and recall. You can adjust this based on your quality requirements.
              </Alert>
            </CardContent>
          </Card>

          <Card sx={{ mb: 3 }}>
