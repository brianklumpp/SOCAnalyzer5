              </Paper>
            </CardContent>
          </Card>

          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom color="primary">
                Troubleshooting
              </Typography>
              <List dense>
                <ListItem>
                  <ListItemText 
                    primary="Scan stuck in processing?"
                    secondary="Wait 20+ minutes for large files. If still stuck, try canceling and re-uploading."
                  />
                </ListItem>
                <ListItem>
                  <ListItemText 
                    primary="No controls extracted?"
                    secondary="Check if PDF is text-based (not scanned image). Try OCR if needed."
                  />
                </ListItem>
                <ListItem>
                  <ListItemText 
                    primary="High-confidence but incorrect data?"
                    secondary="System confidence is based on structure, not semantic accuracy. Always review."
                  />
                </ListItem>
                <ListItem>
                  <ListItemText 
                    primary="Merge suggestions not appearing?"
                    secondary="Refresh the page. If still no suggestions, there may be no duplicates or all below threshold."
                  />
                </ListItem>
                <ListItem>
                  <ListItemText 
                    primary="History dropdown empty?"
                    secondary="Check backend connection. Try refreshing the page or clearing browser cache."
                  />
                </ListItem>
              </List>
            </CardContent>
          </Card>
        </TabPanel>
      </DialogContent>
    </Dialog>
  );
};

export default HelpDialog;
