                    secondary="Validate PDF integrity before upload - corrupted files will fail or produce incorrect results."
                  />
                </ListItem>
                <ListItem>
                  <ListItemText 
                    primary="Don't ignore extraction errors"
                    secondary="Controls flagged as extraction errors (confidence 0.1-0.3) need manual review and correction."
                  />
                </ListItem>
